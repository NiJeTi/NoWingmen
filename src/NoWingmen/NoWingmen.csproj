<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>

        <AssemblyName>NoWingmen</AssemblyName>
        <RootNamespace>NoWingmen</RootNamespace>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

        <Product>NoWingmen</Product>
        <Version>1.0.0</Version>
        
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.*"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
        <PackageReference Include="HarmonyX" Version="2.16.1" />
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile"/>
    </ItemGroup>

    <Target Name="CheckGameAssembly" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('$(GameRefPath)/Assembly-CSharp.dll')"
               Text="Assembly-CSharp.dll not found in '$(GameRefPath)'."/>
    </Target>

    <ItemGroup>
        <Reference Include="$(GameRefPath)/Assembly-CSharp*.dll">
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="Deploy" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePluginsPath)/$(AssemblyName)"/>
        <Message Importance="high" Text="Deployed $(AssemblyName).dll -> $(GamePluginsPath)/$(AssemblyName)"/>
    </Target>
</Project>
